# Copiar a .env.local y completar con los datos del proyecto en
# Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon-o-publishable-key>

# Clave de 32 bytes en base64 para cifrar contraseñas y firmas electrónicas.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde, las credenciales guardadas no se pueden recuperar.
CREDENTIALS_KEY=

# Solo para scripts locales (importación de Excel). Nunca usar en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Email del usuario de Supabase Auth dueño de los datos importados.
IMPORT_OWNER_EMAIL=
